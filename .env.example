# Copia este archivo como .env y rellénalo (ver SETUP.md). NUNCA subas .env al repositorio.
# Todo lo vacío se desactiva solo: el sistema usa el siguiente proveedor o el plan B manual.

# Modo por defecto (opcional; si no, se usa config.yaml): dry-run | review | auto
FABRICA_MODO=

# --- Guiones y voz (capas gratuitas; GEMINI_API_KEY también activa la voz Gemini TTS) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Imágenes IA: Cloudflare Workers AI (plan Free) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Stock gratuito ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- YouTube (OAuth de escritorio) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- TikTok (Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_REFRESH_TOKEN=

# --- Instagram (API con inicio de sesión de Instagram) ---
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Avisos y aprobaciones por Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cifrado de tokens que rotan (genera con: python -m fabrica clave) ---
FABRICA_CLAVE_TOKENS=
